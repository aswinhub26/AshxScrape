{
  "manifest_version": 3,
  "name": "AshxScrape — Google Maps Scraper",
  "version": "1.0.0",
  "description": "Extract business data from Google Maps search results and export to CSV, XLSX, and JSON.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "downloads",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://*.google.co.in/maps/*",
    "https://*.google.co.uk/maps/*",
    "https://*.google.ca/maps/*",
    "https://*.google.com.au/maps/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://*.google.co.in/maps/*",
        "https://*.google.co.uk/maps/*",
        "https://*.google.ca/maps/*",
        "https://*.google.com.au/maps/*"
      ],
      "js": [
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open AshxScrape"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
